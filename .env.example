# Required only for `avianki --ebird CODE`. Catalog regions (avianki us-ma) need no key.
# Get a free key at: https://ebird.org/api/keygen
# EBIRD_API_KEY=your_key_here

# Optional, for the catalog build only (avianki-catalog): xeno-canto metadata (quality grade and
# background species) orders the Commons audio candidates (ADR 0031). Metadata only; no audio is
# downloaded from xeno-canto. Without a key the build keeps the default order and says so in its report.
# Get a free key at: https://xeno-canto.org/account
XC_API_KEY=

# For development only
# UV_PUBLISH_TOKEN=pypi-your_key_here
